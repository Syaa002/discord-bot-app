# Discord Bot Token (Dapatkan dari Discord Developer Portal)
DISCORD_TOKEN=MASUKKAN_TOKEN_DISCORD_ANDA_DISINI

# Client ID Aplikasi Bot
CLIENT_ID=MASUKKAN_CLIENT_ID_DISINI

# Prefix Interaksi Bot (Default: !)
PREFIX=!

# ID Akun Pemilik Bot (Untuk Perintah Developer: !eval, !kill, dll)
OWNER_ID=MASUKKAN_USER_ID_PEMILIK_DISINI

# ===================================================================
# KONFIGURASI WEB DASHBOARD (TEMA ZERO TWO)
# ===================================================================
# Set false jika ingin mematikan web dashboard (misal di bot hosting)
ENABLE_DASHBOARD=true
DASHBOARD_PORT=3000
DASHBOARD_PASSWORD=zerotwo002
DASHBOARD_LOCALHOST_ONLY=true
